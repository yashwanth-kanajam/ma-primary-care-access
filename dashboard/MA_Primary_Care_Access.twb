  <dashboards>
    <dashboard name="Massachusetts primary-care access investigation">
      <style />
      <size minwidth="1400" maxwidth="1400" minheight="1150" maxheight="1150" />
      <zones>
        <zone id="1" x="1500" y="1000" w="97000" h="11500" type-v2="text">
          <formatted-text>
            <run fontsize="14" bold="true">MASSACHUSETTS | PRIMARY-CARE ACCESS
2023 physicians; 2019-2023 ACS. Orange: baseline shortlist. Blue: not selected.
Investigation screen only: physician counts do not prove unmet need or identify a clinic site.
Lower supply + poverty or older-population context; see decision memo for thresholds and uncertainty.</run>
          </formatted-text>
        </zone>
        <zone id="2" name="County map" x="1500" y="14000" w="46500" h="25000" />
        <zone id="3" name="Primary-care physicians per 100,000 residents" x="50500" y="14000" w="48000" h="49000" />
        <zone id="4" name="Poverty context" x="1500" y="42000" w="46500" h="25000" />
        <zone id="5" name="Older-population context" x="1500" y="70000" w="46500" h="26000" />
        <zone id="6" name="Shortlist sensitivity" x="50500" y="66000" w="48000" h="30000" />
      </zones>
    </dashboard>
  </dashboards>
  <windows>
    <window name="Massachusetts primary-care access investigation" maximized="true" class="dashboard">
      <viewpoints>
        <viewpoint name="County map">
          <zoom type="entire-view" />
        </viewpoint>
        <viewpoint name="Primary-care physicians per 100,000 residents">
